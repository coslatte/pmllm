# Neo4j Connection Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Development/Testing Only: Allow using default password (NOT for production!)
# NEO4J_ALLOW_INSECURE=true

# Neo4j Data Directory (for local bulk import)
# NEO4J_DATA_DIR=/path/to/neo4j/data

# Milvus Vector Database Settings
# MILVUS_HOST=127.0.0.1
# MILVUS_PORT=19530

# MinIO Object Storage (used by Milvus)
# Change these from defaults for production!
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# LLM API Settings (LM Studio or compatible OpenAI API)
QWEN_GENERATE_URL=http://localhost:1234/v1/chat/completions
QWEN_GENERATE_MODEL=qwen-1.7b

# Embedding Model Settings
# Leave empty to use default: Alibaba-NLP/gte-Qwen2-1.5B-instruct
# EMBEDDING_MODEL_PATH=Alibaba-NLP/gte-Qwen2-1.5B-instruct

# Or use a local model path if downloaded via LM Studio:
# EMBEDDING_MODEL_PATH=/path/to/local/model

# Build Process Configuration (for CLI build command)
# Input/Output directories
TSV_DIR=mbdump
CSV_OUT_DIR=out_csv
HEADERS_DIR=neo4j_headers
LABELED_DIR=labeled
RELATIONSHIPS_DIR=relationships

# Sampling options
SAMPLE_PERCENT=100.0
SAMPLE_SEED=42

# File processing options
DELIMITER=\t
ENCODING=utf-8
SKIP_HEADERS=false
SKIP_LABELS=false
SKIP_RELATIONSHIPS=false

# Neo4j import options
DB_NAME=musicbrainz.db
ARRAY_DELIMITER=;
ALLOW_BAD_RELATIONSHIPS=false
MULTILINE_FIELDS=true
VERIFY=true

# Neo4j connection for verification (uses NEO4J_USER and NEO4J_PASSWORD above)
NEO4J_HOST=localhost
NEO4J_PORT=7687

# Optional paths
NEO4J_BIN_PATH=
JAVA_HOME=
LEGACY_IMPORT=false
