# ==============================================================================
# Neo4j Bulk Import Tooling
# ==============================================================================
NEO4J_BIN_PATH=
JAVA_HOME=
LEGACY_IMPORT=false
NEO4J_DATA_DIR=
DB_NAME=
ARRAY_DELIMITER=;
ALLOW_BAD_RELATIONSHIPS=false
MULTILINE_FIELDS=true
VERIFY=true

# ==============================================================================
# Neo4j Runtime & Verification
# ==============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=pmllmdb
NEO4J_ALLOW_INSECURE=false
NEO4J_HOST=localhost
NEO4J_PORT=7687

# ==============================================================================
# Vector & Object Storage
# ==============================================================================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ==============================================================================
# Model Gateway (LLM & Embeddings)
# ==============================================================================
MODEL_GATEWAY_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-qat
MODEL_GATEWAY_LLM_MODEL=gemma-3-1b-it-qat
MODEL_GATEWAY_DEVICE=cpu
MODEL_GATEWAY_DTYPE=float32
MODEL_GATEWAY_MAX_NEW_TOKENS=512
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-qat
EMBEDDING_API_URL=http://localhost:9000/v1/embeddings
EMBEDDING_API_TIMEOUT=60
LLM_MODEL=gemma-3-1b-it-qat
LLM_API_URL=http://localhost:9000/v1/chat/completions
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_API_TIMEOUT=120
MODEL_API_KEY=

# ==============================================================================
# Chat & Preference Store
# ==============================================================================
CHAT_DB_USER=pmllm
CHAT_DB_PASSWORD=pmllm
CHAT_DB_HOST=pmllm-user-db
CHAT_DB_PORT=5432
CHAT_DB_NAME=pmllm_chat
CHAT_DB_URL=postgresql+psycopg2://pmllm:pmllm@pmllm-user-db:5432/pmllm_chat
CHAT_DB_EXTERNAL_PORT=5433
CHAT_DB_PATH=./storage/local_app.db
CHAT_SERVICE_URL=http://localhost:8080

# ==============================================================================
# Data Sources & Outputs
# ==============================================================================
OUTPUT_DIR=output
TSV_CORE_DIR=
TSV_DERIVED_DIR=
CSV_CORE_DIR=output/converted/core
CSV_DERIVED_DIR=output/converted/derived

# ==============================================================================
# Sampling, Demo, and Vector Build Controls
# ==============================================================================
SAMPLE_PERCENT=100.0
SAMPLE_SEED=123
DEMO_MODE=true
DEMO_SAMPLE_PERCENT=0.1
DEMO_VECTOR_SAMPLE_PERCENT=0.1
# Uncomment to force a fixed worker count (auto mode uses 75% of usable cores)
# VECTOR_BUILD_WORKERS=4
VECTOR_BUILD_WORKER_PERCENT=0.75
VECTOR_BUILD_MAX_CORES=8
VECTOR_BUILD_SAMPLE_PERCENT=1.0
TEST_MODE=true
TEST_SAMPLE_PERCENT=1.0
VECTOR_LABELS=Artist,Recording,Release,ReleaseGroup,Work,Area,Tag,ArtistCredit,Label,Medium,Track,Place,Event,Genre,Instrument,Series,Url

# ==============================================================================
# File Processing Defaults
# ==============================================================================
DELIMITER=\t
ENCODING=utf-8
SKIP_HEADERS=false
SKIP_LABELS=false
SKIP_RELATIONSHIPS=false

# ==============================================================================
# Derived Data Processing (See docs/ENVIRONMENT.md for details)
# ==============================================================================
PROCESS_LABELS=true
PROCESS_MEDIUMS=true
PROCESS_TRACKS=true
PROCESS_PLACES=true
PROCESS_EVENTS=true
PROCESS_GENRES=true
PROCESS_INSTRUMENTS=true
PROCESS_SERIES=true
PROCESS_URLS=true
PROCESS_ALIASES=true
PROCESS_TYPES=true
PROCESS_ATTRIBUTES=true
PROCESS_CREDITS=true
PROCESS_LANGUAGES=true
PROCESS_PACKAGING=true
PROCESS_STATUSES=true
PROCESS_EXTENDED_RELATIONSHIPS=true
RELATIONSHIPS_TO_SKIP=
PROCESS_REDIRECTS=false
PROCESS_ISNI_IPI=false
PROCESS_ISRC_ISWC=false
PROCESS_CDTOC=false
