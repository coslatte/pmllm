# Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Development/Testing Only
# NEO4J_ALLOW_INSECURE=true

# Neo4j Data Directory
# NEO4J_DATA_DIR=/path/to/neo4j/data

# Milvus Vector Database
# MILVUS_HOST=127.0.0.1
# MILVUS_PORT=19530

# MinIO Object Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# LLM API Settings
QWEN_GENERATE_URL=http://localhost:1234/v1/chat/completions
QWEN_GENERATE_MODEL=qwen-1.7b

# Embedding Model
# EMBEDDING_MODEL_PATH=Alibaba-NLP/gte-Qwen2-1.5B-instruct

# Build Process Directories
OUTPUT_DIR=output
# TSV source directories - separate core and derived data
TSV_CORE_DIR=music_metadata
TSV_DERIVED_DIR=music_derived_metadata

# Sampling Options
SAMPLE_PERCENT=100.0
SAMPLE_SEED=42

# File Processing
DELIMITER=\t
ENCODING=utf-8
SKIP_HEADERS=false
SKIP_LABELS=false
SKIP_RELATIONSHIPS=false

# Derived Data Processing
# See ENVIRONMENT.md for detailed descriptions
PROCESS_LABELS=true
PROCESS_MEDIUMS=true
PROCESS_TRACKS=true
PROCESS_PLACES=true
PROCESS_EVENTS=true
PROCESS_GENRES=true
PROCESS_INSTRUMENTS=true
PROCESS_SERIES=true
PROCESS_URLS=true
PROCESS_ALIASES=true
PROCESS_TYPES=true
PROCESS_ATTRIBUTES=true
PROCESS_CREDITS=true
PROCESS_LANGUAGES=true
PROCESS_PACKAGING=true
PROCESS_STATUSES=true
PROCESS_EXTENDED_RELATIONSHIPS=true
RELATIONSHIPS_TO_SKIP=
PROCESS_REDIRECTS=false
PROCESS_ISNI_IPI=false
PROCESS_ISRC_ISWC=false
PROCESS_CDTOC=false

# Neo4j Import
DB_NAME=
ARRAY_DELIMITER=;
ALLOW_BAD_RELATIONSHIPS=false
MULTILINE_FIELDS=true
VERIFY=true

# Neo4j Verification Connection
NEO4J_HOST=localhost
NEO4J_PORT=7687

# Optional Paths
# Neo4j bin directory path (for Neo4j Desktop installations)
# Windows example: C:\Users\TheUser\.Neo4jDesktop2\Data\dbmss\dbms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\bin
# Linux/Mac example: /path/to/neo4j/bin
NEO4J_BIN_PATH=
# Java home directory (JAVA_HOME environment variable)
# Windows: Run in PowerShell: echo $env:JAVA_HOME
# Linux/Mac: echo $JAVA_HOME
JAVA_HOME=
# Legacy import works for older Neo4j versions (< 5.0)
LEGACY_IMPORT=false
